<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Light theme. The app draws edge to edge; screens pad themselves for the system bars. -->
    <style name="Base.Theme.ITantra" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <item name="colorPrimaryContainer">@color/brand_tint</item>
        <item name="colorOnPrimaryContainer">@color/brand_deep</item>
        <item name="colorSecondaryContainer">@color/brand_tint</item>
        <item name="colorOnSecondaryContainer">@color/brand_deep</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/alert</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="materialButtonStyle">@style/Widget.ITantra.Button</item>
        <item name="textInputStyle">@style/Widget.ITantra.TextInput</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.ITantra.BottomSheet</item>
    </style>

    <style name="Theme.ITantra" parent="Base.Theme.ITantra" />

    <style name="ThemeOverlay.ITantra.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.ITantra.BottomSheet</item>
    </style>
</resources>
