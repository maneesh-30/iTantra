<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- ============ SCREEN 1: JOIN ============ -->
    <LinearLayout
        android:id="@+id/joinScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="iTantra"
            android:textColor="@color/amber"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voice that gets through — offline."
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:paddingBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_mission"
            android:padding="16dp">

            <TextView style="@style/FieldLabel" android:text="YOUR NAME" />
            <EditText
                android:id="@+id/etName"
                style="@style/FieldInput"
                android:hint="e.g. Maneesh"
                android:inputType="textPersonName|textCapWords" />

            <TextView style="@style/FieldLabel" android:text="CHANNEL"
                android:paddingTop="14dp" />
            <EditText
                android:id="@+id/etChannel"
                style="@style/FieldInput"
                android:hint="e.g. RESCUE-1"
                android:inputType="text"
                android:text="RESCUE-1" />

            <TextView style="@style/FieldLabel" android:text="LANGUAGE"
                android:paddingTop="14dp" />
            <Spinner
                android:id="@+id/spinnerLang"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/chip_card"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnJoin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:text="Join channel"
            android:textStyle="bold"
            android:textColor="@color/on_amber"
            android:backgroundTint="@color/amber" />

        <TextView
            android:id="@+id/tvJoinStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="12dp"
            android:text="Loading models…"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnBenchmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:paddingTop="20dp"
            android:paddingBottom="8dp"
            android:text="Run accuracy benchmark (WER)"
            android:textColor="@color/amber"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- ============ SCREEN 2+3: APP (Chat / Radar) ============ -->
    <LinearLayout
        android:id="@+id/appScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Mission header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_mission"
            android:layout_margin="12dp"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvChannel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="RESCUE-1"
                    android:textColor="@color/ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSignal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● strong"
                    android:textColor="@color/amber"
                    android:textSize="12sp"
                    android:paddingEnd="12dp" />

                <TextView
                    android:id="@+id/btnLeave"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Leave"
                    android:textColor="@color/danger"
                    android:textSize="13sp"
                    android:padding="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="6dp">

                <TextView
                    android:id="@+id/tvPeople"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 in room"
                    android:textColor="@color/muted"
                    android:textSize="12sp"
                    android:paddingEnd="14dp" />

                <TextView
                    android:id="@+id/tvTimer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="00:00"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="offline"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Content: chat OR radar -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- CHAT -->
            <LinearLayout
                android:id="@+id/chatScreen"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ScrollView
                    android:id="@+id/scrollMessages"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/messagesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp" />
                </ScrollView>

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Hold to talk"
                    android:textColor="@color/muted"
                    android:textSize="12sp"
                    android:paddingBottom="6dp" />

                <CheckBox
                    android:id="@+id/cbSendAlert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:buttonTint="@color/danger"
                    android:text="Send as alert"
                    android:textColor="@color/danger"
                    android:textSize="13sp"
                    android:paddingBottom="6dp" />

                <Button
                    android:id="@+id/btnRecord"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/holdbar"
                    android:text="Hold to Talk"
                    android:textStyle="bold"
                    android:textColor="@color/on_amber"
                    android:stateListAnimator="@null" />
            </LinearLayout>

            <!-- RADAR (view-only) -->
            <LinearLayout
                android:id="@+id/radarScreen"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <com.itantra.app.RadarView
                    android:id="@+id/radar"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Everyone you've heard on this channel"
                    android:textColor="@color/muted"
                    android:textSize="12sp"
                    android:paddingBottom="16dp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Bottom nav -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/card"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/btnTabChat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Talk"
                android:textColor="@color/amber"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="10dp" />

            <TextView
                android:id="@+id/btnTabRadar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Radar"
                android:textColor="@color/muted"
                android:textSize="14sp"
                android:padding="10dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
